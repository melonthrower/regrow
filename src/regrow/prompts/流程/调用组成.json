    "action_text": {
      "intro": "直接返回一个JSON对象。先选择action，只填写所选动作需要的字段；未使用的字段省略。",
      "table_header": "| action | 需要填写的字段 |",
      "none": "无法选择有依据的操作、原问题仍未回答时填写action=\"none\"。",
      "none_with_task": [
        "以下两种情况选一种：",
        "- 仅说明本步不操作：填写reason。",
        "- 登记当前任务判断：填写task_update，判断依据写在task_update.reason；外层不填reason。",
        "task_update只填写本轮所需字段；字段含义及示例见相应说明。"
      ],
      "none_reason": "填写reason说明本步不操作的原因。",
      "merged_table_header": "| action | 需要填写的字段 | 操作含义 |",
      "complete": "选择action=\"complete\"时，填写reason及本轮要求的答案字段。",
      "products": "complete的答案字段（与action同层；以下必填标记仅约束complete，none的部分答案按其格式选填）：",
      "none_without_complete": "本步不操作时填写action=\"none\"。",
      "none_progress": [
        "已有已确认的部分答案时，可在none回复同层填写对应答案字段，reason说明依据及尚未回答的部分。",
        "确有推进障碍需要暂挂时，另填retry_when说明何种条件改变后可以重新考虑；没有暂挂判断就省略。"
      ]
    }
  },
  "messages": {
    "location_target": "当前截图中的「{target}」在哪里，是否属于原登记对象？",
    "discovery_global": "当前前景有哪些操作区或展示区，其中能确认哪些控件及其归属和身份？",
    "discovery_focus": "原工作区块是否在其中？",
    "discovery_repair_purpose": "定位当前前景区块，为后续核对原问题提供区块身份。",
    "discovery_local": "指定区块是否仍对应当前表面？有哪些未登记或确有变化的对象需要补充？",
    "task_focused": "指定旧问题已有怎样的答案或缺口？本轮新发现还需登记什么？",
    "discovery_completion": "同一截图原观察范围内，哪些待补事项可以确认，哪些仍缺依据，还有什么遗漏？",
    "discovery_completion_purpose": "补全原观察范围内的未登记内容",
    "entry_answer": "原入口直接对应哪个内容区块、该区块的一级用途是什么，有什么证据支持此关联？目标区块各控件的后续操作由其自身任务回答。",
    "discovery_objects_question": "当前区块和控件分别是什么，如何对应已有身份？",
    "discovery_objects_output": "regions / controls：登记本图能确认的区块、控件及归属；未确认项保留具体缺口。",
    "inventory_review": "对照原问题和已提供观察补充事实，明确继续、已回答或暂挂；不执行新动作。"
