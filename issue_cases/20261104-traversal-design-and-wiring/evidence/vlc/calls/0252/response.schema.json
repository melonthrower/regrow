                },
                "needs_exploration": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "控件自身用法是否还有影响后续使用的具体未知；不确定填null。"
                },
                "image_conditions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "仅add_image=true时描述本张按钮状态图的适用条件；通用图填[]。"
                },
                "add_image": {
                  "type": "boolean",
                  "description": "仅真实按钮外观/语义状态变化时补状态图；默认false。文本框内容、位置、区块划分和窗口大小变化不算。"
                }
              },
              "required": [],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "ref"
                    ]
                  },
                  "then": {},
                  "else": {
                    "required": [
                      "knowledge",
                      "may_open_content",
                      "needs_exploration",
                      "name"
                    ]
                  }
                }
              ],
              "description": "已有控件用ref及变化信息；新控件省略ref并填写新对象资料。"
