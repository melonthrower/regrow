{
  "type": "object",
  "properties": {
    "foreground": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "exception": {
          "type": "string",
          "enum": [
            "none",
            "blocking_popup",
            "system_error",
            "unexpected_exit",
            "external_app",
            "unclassified",
            "region_ownership_review"
          ]
        },
        "recovery_handoff": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "exception",
        "recovery_handoff"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "bbox": {
            "$ref": "#/$defs/shared_1"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "已有对象填写材料中的稳定编号；新对象可省略并明确identity=new。"
          },
          "identity": {
            "type": "string",
            "enum": [
              "same",
              "new",
              "uncertain"
            ]
          },
          "identity_evidence": {
            "type": "string",
            "description": "身份未定或存在歧义时说明具体依据和缺口。"
          },
          "local_knowledge": {
            "type": "object",
            "properties": {
              "add": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "update": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "delete": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "state_description": {
            "type": "string",
            "minLength": 1,
            "description": "本次图中影响内容或操作集合的状态；只写已观察事实，不改变区块身份，不推断未报告对象不存在。"
          },
          "task_review_reason": {
            "type": "string",
            "description": "仅有尚未被现有任务覆盖的新问题或旧结论失效时说明具体对象和问题；其他知识更新省略。"
          },
          "context_matches": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "仅复用有行为适用上下文的历史区块时判断：当前截图满足该上下文填true，不满足填false，无法判断或无此限定填null。身份未定时用identity_evidence说明具体缺口。"
          },
          "out_of_scope_reason": {
            "type": "string",
            "description": "只依据本轮用户允许的探索范围判断：整个区块都不应开展业务探索时写具体原因；范围内或不能确定时填空。共享导航与范围外内容应分开。不是完成声明。"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {
                  "$ref": "#/$defs/shared_1"
                },
                "description": {
                  "type": "string",
                  "description": "仅需补充辨认特征时填写；名称已足够时省略。用途写knowledge。"
                },
                "ref": {
                  "type": "string",
                  "enum": [
                    "File 菜单",
                    "Edit 菜单",
                    "View 菜单",
                    "Insert 菜单",
                    "Format 菜单",
                    "Slide 菜单",
                    "第 1 张幻灯片缩略图",
                    "第 2 张幻灯片缩略图",
                    "第 3 张幻灯片缩略图",
                    "幻灯片页面",
                    "参与提示横幅关闭按钮",
                    "捐赠提示横幅关闭按钮",
                    "Format 下拉框",
                    "Orientation 下拉框",
                    "Background 下拉框",
                    "Insert Image 按钮",
                    "Master Slide 下拉框",
                    "Master Background 复选框",
                    "Master Objects 复选框",
                    "Master View 按钮",
                    "幻灯片布局缩略图组",
                    "Slide Show 菜单",
                    "Tools 菜单",
                    "Window 菜单",
                    "Help 菜单",
                    "打开文件按钮",
                    "保存按钮",
                    "导出为 PDF 按钮",
                    "打印按钮",
                    "撤销按钮",
                    "重做按钮",
                    "查找按钮",
                    "拼写检查按钮",
                    "插入表格按钮",
                    "插入图像按钮",
                    "插入视频按钮",
                    "插入图表按钮",
                    "插入文本框按钮",
                    "特殊字符按钮",
                    "超链接按钮",
                    "选择工具",
                    "缩放工具",
                    "线条工具",
                    "矩形工具",
                    "椭圆工具",
                    "箭头工具",
                    "自由线条工具",
                    "连接符工具",
                    "形状工具组",
                    "新建演示文稿按钮",
                    "缩小按钮",
                    "缩放滑块",
                    "放大按钮"
                  ],
                  "description": "已有控件填写控件树中的ID；新控件省略。"
                },
                "name": {
                  "type": "string"
                },
                "list_group": {
                  "type": "string"
                },
                "knowledge": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "修订给定已有知识时引用其序号；新增省略。"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "description": "控件用途与规则；必要的页面、模式和限制写在同一描述中。"
                      },
                      "constraints": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "object",
                          "properties": {
                            "description": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "description"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "description"
                    ],
                    "additionalProperties": false
                  }
                },
                "may_open_content": {
                  "type": "boolean",
                  "description": "是否打开或展开与应用主要功能相关、具有探索价值的内容。"
                },
                "needs_exploration": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "控件自身用法是否还有影响后续使用的具体未知；不确定填null。"
                }
              },
              "required": [],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "ref"
                    ]
                  },
                  "then": {},
                  "else": {
                    "required": [
                      "knowledge",
                      "may_open_content",
                      "needs_exploration",
                      "name"
                    ]
                  }
                }
              ],
              "description": "已有控件用ref及变化信息；新控件省略ref并填写新对象资料。"
            }
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ref"
              ]
            },
            "then": {
              "properties": {
                "identity": {
                  "const": "same"
                },
                "ref": {}
              }
            },
            "else": {
              "required": [
                "name",
                "description",
                "identity"
              ],
              "properties": {
                "identity": {
                  "enum": [
                    "new",
                    "uncertain"
                  ]
                },
                "ref": {
                  "enum": [
                    null,
                    ""
                  ]
                }
              }
            }
          }
        ],
        "description": "旧对象引用ref并只报新信息。新对象明确identity=new；身份未定用uncertain和具体缺口。"
      },
      "maxItems": 1,
      "description": "仅登记指定区块及其直接所属控件；不在本步展开其他同屏区块。"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focus_presence": {
      "type": "string",
      "enum": [
        "interactive",
        "not_interactive",
        "uncertain"
      ],
      "description": "指定区块的前景归属：interactive表示处于当前前景，可继续观察或导航，不要求有控件；not_interactive表示不在当前前景或被其他表面接管；uncertain表示归属未确认。"
    }
  },
  "required": [
    "foreground",
    "regions",
    "uncertainties",
    "focus_presence"
  ],
  "additionalProperties": false,
  "$defs": {
    "shared_2": {
      "type": "object",
      "properties": {
        "left": {
          "type": "integer"
        },
        "top": {
          "type": "integer"
        },
        "right": {
          "type": "integer"
        },
        "bottom": {
          "type": "integer"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "additionalProperties": false
    },
    "shared_1": {
      "anyOf": [
        {
          "$ref": "#/$defs/shared_2"
        },
        {
          "type": "null"
        }
      ],
      "description": "新对象提供来源截图中的身份裁图范围，无法可靠裁图时填null；旧对象复认可省略，需要更新身份图时再填写，不是操作范围。"
    }
  }
}
