                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "修订给定已有知识时引用其序号；新增省略。"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "description": "控件用途与规则；必要的页面、模式和限制写在同一描述中。"
                      },
                      "constraints": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
