{
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "description": "已有候选使用可登记动作身份region/control；未登记目标用准确描述，区域动作描述意图。"
    },
    "action": {
      "type": "string",
      "enum": [
        "click",
        "double_click",
        "long_press",
        "input_text",
        "scroll",
        "back",
        "wait",
        "none",
        "key_press",
        "hotkey",
        "hover",
        "right_click",
        "drag"
      ]
    },
    "x": {
      "type": [
        "integer",
        "null"
      ]
    },
    "y": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "end_x": {
      "type": [
        "integer",
        "null"
      ]
    },
    "end_y": {
      "type": [
        "integer",
        "null"
      ]
    },
    "skip_task": {
      "type": "boolean",
      "description": "仅当前任务违反明确的遍历限制时为true，搭配none和具体原因；普通动作或定位困难填false。"
    }
  },
  "required": [
    "target",
    "action",
    "x",
    "y",
    "reason",
    "text",
    "end_x",
    "end_y",
    "skip_task"
  ],
  "additionalProperties": false
}
