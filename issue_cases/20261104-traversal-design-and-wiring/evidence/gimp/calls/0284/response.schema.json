                },
                "description": {
                  "type": "string",
                  "description": "仅需补充辨认特征时填写；名称已足够时省略。用途写knowledge。"
                },
                "name": {
                  "type": "string"
                },
                "list_group": {
                  "type": "string"
                },
                "knowledge": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "修订给定已有知识时引用其序号；新增省略。"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "description": "控件用途与规则；必要的页面、模式和限制写在同一描述中。"
                      },
                      "constraints": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "object",
                          "properties": {
                            "description": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "description"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "description"
                    ],
                    "additionalProperties": false
                  }
                },
                "may_open_content": {
                  "type": "boolean",
                  "description": "是否打开或展开与应用主要功能相关、具有探索价值的内容。"
                },
                "needs_exploration": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "控件自身用法是否还有影响后续使用的具体未知；不确定填null。"
                },
                "image_conditions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "仅add_image=true时描述本张按钮状态图的适用条件；通用图填[]。"
                },
                "add_image": {
                  "type": "boolean",
                  "description": "仅真实按钮外观/语义状态变化时补状态图；默认false。文本框内容、位置、区块划分和窗口大小变化不算。"
                }
              },
              "required": [],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "ref"
                    ]
                  },
                  "then": {},
                  "else": {
                    "required": [
                      "knowledge",
                      "may_open_content",
                      "needs_exploration",
                      "name"
                    ]
                  }
                }
              ],
              "description": "已有控件用ref及变化信息；新控件省略ref并填写新对象资料。"
            }
          },
          "current": {
            "type": "boolean"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ref"
              ]
            },
            "then": {
              "properties": {
                "identity": {
                  "const": "same"
                },
                "ref": {}
              }
            },
            "else": {
              "required": [
                "name",
                "description",
                "identity"
              ],
              "properties": {
                "identity": {
                  "enum": [
                    "new",
                    "uncertain"
                  ]
                },
                "ref": {
                  "enum": [
                    null,
                    ""
                  ]
                }
              }
            }
          }
        ],
        "description": "旧对象引用ref并只报新信息。新对象明确identity=new；身份未定用uncertain和具体缺口。"
      },
      "description": "本次识别或更新的区块；划分与复用依据实际观察。"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_result": {
      "type": "object",
      "properties": {
        "exception": {
          "type": "string",
          "enum": [
            "none",
            "blocking_popup",
            "system_error",
            "unexpected_exit",
            "external_app",
            "unclassified"
          ]
        },
        "description": {
          "type": "string",
          "description": "实际观察到的结果和未确认事项，不把预期当事实。"
        },
        "recovery_handoff": {
          "type": "string"
        },
        "returns_to_previous": {
          "type": "boolean",
          "description": "刚执行的动作是否已返回进入前的位置，或已关闭浮层恢复下方界面。打开菜单/对话框为false，不因之后可关闭而填true；固定目标导航或语义未确认也为false"
        }
      },
      "required": [
        "exception",
        "description",
        "recovery_handoff",
        "returns_to_previous"
      ],
      "additionalProperties": false
    },
    "jump_to": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "control": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "region"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "index",
              "conditions"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "task_update": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "裁剪约束模式候选列表/功能探索"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "continue",
              "answered",
              "defer"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "按需补充判断理由；不重复动作结果或已有知识。"
          },
          "remaining_question": {
            "type": "string",
            "minLength": 1,
            "description": "decision为continue或defer时必填：原问题尚未回答的具体部分；answered时不填写。"
          },
          "retry_when": {
            "type": "string",
            "minLength": 1,
            "description": "decision为defer时必填：何种条件满足后可重新推进；其他decision不填写。"
          },
          "next_action": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "control": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "click",
                      "double_click",
                      "long_press",
                      "input_text",
                      "scroll",
                      "key_press",
                      "hotkey",
                      "hover",
                      "right_click",
                      "drag",
                      "back",
                      "wait"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "region",
                  "control",
                  "action",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "task",
          "decision"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "enum": [
                    "continue",
                    "defer"
                  ]
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "required": [
                "remaining_question"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "defer"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "required": [
                "retry_when"
              ]
            }
          }
        ]
      }
    },
    "function_updates": {
      "type": "array",
      "items": {
        "type": "object",
