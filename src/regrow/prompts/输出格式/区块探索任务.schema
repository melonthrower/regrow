{
  "type": "object",
  "properties": {
    "inventory": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "uncertain"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "task_update": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "done",
              "pending",
              "blocked"
            ]
          },
          "remaining_question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "retry_when": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "task",
          "state"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "pending",
                    "blocked"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "required": [
                "remaining_question"
              ]
            },
            "else": {
              "properties": {
                "remaining_question": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "blocked"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "required": [
                "retry_when"
              ]
            },
            "else": {
              "properties": {
                "retry_when": false
              }
            }
          }
        ]
      }
    },
    "shared_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string",
            "minLength": 1
          },
          "source_region": {
            "type": "string",
            "minLength": 1
          },
          "source_control": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "control",
          "source_region",
          "source_control",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "new_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "control",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "inventory",
    "evidence",
    "new_tasks",
    "shared_instances"
  ],
  "additionalProperties": false
}
