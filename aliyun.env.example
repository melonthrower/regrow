# ============================================================
# 阿里云 ECS Provider 配置模板 (aliyun.env.example)
# ------------------------------------------------------------
# 用法：填好下面的值后，把这些行【追加】到项目根目录的 .env 文件里
# （aliyun 的 manager 用 dotenv 读 .env，放同一个文件即可生效）。
# 不要把真实密钥提交到 git —— .env 应在 .gitignore 中。
# ============================================================

# --- 访问凭证（阿里云 RAM 控制台创建 AccessKey，授权 ECS 权限）---
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret

# --- 地域：实例、镜像、vSwitch、安全组必须都在【同一地域】---
# 例：cn-hangzhou / cn-shanghai / eu-central-1
ALIYUN_REGION=cn-hangzhou

# --- 自定义镜像 ID：内置 Ubuntu 桌面 + noVNC + 5000 端口 OSWorld server ---
# 由你的 33G VM 转换/制作而来（见迁移文档的镜像制作步骤）
ALIYUN_IMAGE_ID=m-xxxxxxxxxxxxxxxx

# --- 实例规格：1920x1080 桌面建议至少 2c4g ---
# 例：ecs.e-c1m2.large
ALIYUN_INSTANCE_TYPE=ecs.e-c1m2.large

# --- 网络：VPC 内的交换机 + 安全组（同地域）---
ALIYUN_VSWITCH_ID=vsw-xxxxxxxxxxxxxxxx
ALIYUN_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxx

# --- 可选：资源组（没有就留空/删掉）---
# ALIYUN_RESOURCE_GROUP_ID=rg-xxxxxxxx

# --- 可选：用私网 IP 还是公网 IP 连 5000 端口的 server ---
# 控制端在【本机/外网】跑时设为 0（用公网 IP）；
# 控制端也在阿里云【同 VPC 内】跑时设为 1（用私网 IP，免公网流量费）。
ALIYUN_USE_PRIVATE_IP=0
