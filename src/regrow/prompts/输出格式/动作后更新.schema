{
  "type": "object",
  "properties": {
    "foreground": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "新对象提供来源截图中的身份裁图范围，无法可靠裁图时填null；旧对象复认可省略，需要更新身份图时再填写，不是操作范围。"
          },
          "ref": {
            "type": "string",
            "description": "已有对象的名称/文字；新对象为空；同名不证明身份。"
          }
        },
        "required": [
          "name",
          "description",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_index": {
            "type": "integer",
            "description": "唯一直接所属Region的0起始行号"
          },
          "ref": {
            "type": "string",
            "description": "已有对象的名称/文字；新对象为空；同名不证明身份。"
          },
          "description": {
            "type": "string",
            "description": "控件的稳定外观和作用对象描述。"
          },
          "appearance_bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "新对象提供来源截图中的身份裁图范围，无法可靠裁图时填null；旧对象复认可省略，需要更新身份图时再填写，不是操作范围。"
          },
          "click_bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "实际操作目标范围；与用于辨认的appearance_bbox分别填写，可省略。"
          },
          "icon_description": {
            "type": "string",
            "description": "图标外观，用于历史辨认；没有图标时可省略。"
          }
        },
        "required": [
          "region_index",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "action_result": {
      "type": "object",
      "properties": {
        "exception": {
          "type": "string",
          "enum": [
            "none",
            "blocking_popup",
            "unexpected_exit",
            "external_app",
            "unclassified",
            "uncertain",
            "system_error"
          ]
        },
        "recovery_handoff": {
          "type": "string"
        }
      },
      "required": [
        "exception"
      ],
      "additionalProperties": false
    },
    "current_regions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "description": "已确认的既有区块编号。"
              }
            },
            "required": [
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "region_index": {
                "type": "integer",
                "minimum": 0,
                "description": "本次regions中的位置，从0开始。"
              }
            },
            "required": [
              "region_index"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "function_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "add": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "supports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "target_role": {
                  "type": "string",
                  "minLength": 1
                },
                "access_entry": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "description",
                "supports"
              ],
              "additionalProperties": false
            }
          },
          "update": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "changes": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "supports": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "parameters": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "target_role": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "access_entry": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "ref",
                "changes"
              ],
              "additionalProperties": false
            }
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "replace_with": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "region"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "foreground",
    "regions",
    "controls",
    "action_result",
    "current_regions"
  ],
  "additionalProperties": false
}
