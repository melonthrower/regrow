              "required": [
                "ref"
              ]
            },
            "then": {
              "properties": {
                "identity": {
                  "const": "same"
                },
                "ref": {}
              }
            },
            "else": {
              "required": [
                "name",
                "description",
                "identity"
              ],
              "properties": {
                "identity": {
                  "enum": [
                    "new",
                    "uncertain"
                  ]
                },
                "ref": {
                  "enum": [
                    null,
                    ""
                  ]
                }
              }
            }
          }
        ],
        "description": "旧对象引用ref并只报新信息。新对象明确identity=new；身份未定用uncertain和具体缺口。"
      },
      "description": "本次识别或更新的区块；划分与复用依据实际观察。"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_result": {
      "type": "object",
      "properties": {
        "exception": {
          "type": "string",
          "enum": [
            "none",
            "blocking_popup",
            "system_error",
            "unexpected_exit",
            "external_app",
            "unclassified"
          ]
        },
        "description": {
          "type": "string",
          "description": "实际观察到的结果和未确认事项，不把预期当事实。"
        },
        "recovery_handoff": {
          "type": "string"
        },
        "returns_to_previous": {
          "type": "boolean",
          "description": "刚执行的动作是否已返回进入前的位置，或已关闭浮层恢复下方界面。打开菜单/对话框为false，不因之后可关闭而填true；固定目标导航或语义未确认也为false"
        }
      },
      "required": [
        "exception",
        "description",
        "recovery_handoff",
        "returns_to_previous"
      ],
      "additionalProperties": false
    },
    "jump_to": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
