{
  "type": "object",
  "properties": {
    "foreground": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "evidence",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "parent_index": {
            "type": [
              "integer",
              "null"
            ],
            "description": "本轮regions数组0起始父行号；无父级为null。不是跨图身份ID。"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_name": {
            "type": "string",
            "description": "已有对象的名称/文字；新对象为空；同名不证明身份。"
          }
        },
        "required": [
          "name",
          "parent_index",
          "description",
          "reason",
          "bbox",
          "previous_name"
        ],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_index": {
            "type": "integer",
            "description": "唯一直接所属Region的0起始行号"
          },
          "text": {
            "type": "string"
          },
          "icon_appearance": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "possible_operation": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          },
          "bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "识别身份的框，包含相关标签与控件；整屏坐标。"
          },
          "icon_bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_name": {
            "type": "string",
            "description": "已有对象的名称/文字；新对象为空；同名不证明身份。"
          },
          "click_bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "实际可操作区域的框；整屏坐标。不把旁边的说明文字当点击位置，无法确定填null。"
          }
        },
        "required": [
          "region_index",
          "text",
          "icon_appearance",
          "state",
          "possible_operation",
          "uncertainty",
          "bbox",
          "icon_bbox",
          "previous_name"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_result": {
      "type": "object",
      "properties": {
        "exception": {
          "type": "string",
          "enum": [
            "none",
            "blocking_popup",
            "unexpected_exit",
            "external_app",
            "unclassified",
            "uncertain",
            "system_error"
          ]
        },
        "description": {
          "type": "string",
          "description": "实际观察到的结果和未确认事项，不把预期当事实。"
        },
        "evidence": {
          "type": "string"
        },
        "recovery_handoff": {
          "type": "string"
        },
        "returns_to_previous": {
          "type": "boolean",
          "description": "刚执行的动作是否已返回进入前的位置，或已关闭浮层恢复下方界面。打开菜单/对话框为false，不因之后可关闭而填true；固定目标导航或语义未确认也为false"
        }
      },
      "required": [
        "exception",
        "description",
        "evidence"
      ],
      "additionalProperties": false
    },
    "previous_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "retained_interactive",
              "changed_interactive",
              "visible_background_blocked",
              "not_visible",
              "uncertain"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "evidence",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "exploration_update": {
      "type": "object",
      "properties": {
        "attempt_status": {
          "type": "string",
          "enum": [
            "executed",
            "not_executed",
            "uncertain"
          ]
        },
        "outcome": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "attempt_status",
        "outcome",
        "evidence"
      ],
      "additionalProperties": false
    },
    "handoff_summary": {
      "type": "string"
    }
  },
  "required": [
    "foreground",
    "regions",
    "controls",
    "excluded",
    "uncertainties",
    "action_result",
    "previous_regions",
    "exploration_update",
    "handoff_summary"
  ],
  "additionalProperties": false
}
