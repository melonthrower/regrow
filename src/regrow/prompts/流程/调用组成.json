  "work": {
    "locate": {
      "question": "当前前景有哪些操作区或展示区，其中有哪些控件？哪些对应已有身份，哪些还需要辨认？",
      "label": "发现或定位",
      "guidance": "识别当前前景与指定对象；定位服务于原任务，不代表原问题已回答。"
    },
    "task_proposal": {
      "question": "本区块哪些功能已经了解，哪些仍有值得探索的具体问题？",
      "label": "区块任务清点",
      "guidance": "按当前观察补充本区块的未知或本轮指定的旧问题；沿用已有任务。未展开的旧任务仍保留覆盖义务。"
    },
    "scope_review": {
      "question": "这些既有问题是否已有答案，仍需继续调查，还是受阻？",
      "label": "既有任务范围复核",
      "guidance": "复核本区块全部需复核的未完成任务，保留原绑定；不能只回报新增项。"
    },
    "action": {
      "label": "推进探索任务",
      "guidance": "围绕原问题选择下一动作；必要准备不替换原目标。",
      "question_from": "action_selection"
    },
    "navigate": {
      "label": "到达工作区块",
      "guidance": "根据当前界面推进到目标区块；实际导航与原探索任务分别保留归属。",
      "question_from": "action_selection"
    },
    "update": {
      "question": "刚才的实际操作改变了什么？这些观察回答了原探索问题的哪一部分？",
      "label": "登记实际动作结果",
      "guidance": "登记本次真实动作及观察，判断它回答了原问题的哪一部分；不以准备代替目标执行。"
    },
    "function_registration": {
      "question": "已有探索材料说明本区块能做什么，以及需要哪些参数和条件？",
      "label": "整理区块功能",
      "guidance": "整理已有任务知识和明确支持，不重新执行已知功能。"
    },
    "recover": {
      "question": "什么阻碍了当前探索？怎样解除阻碍并交还原任务？",
      "label": "恢复探索现场",
      "guidance": "处理当前异常并保留原工作目标；恢复不等于任务完成。"
    },
    "step_observation": {
      "question": "补充截图能否回答原步骤尚未看清的问题？",
      "label": "补充原步骤的观察",
      "guidance": "仅回答原步骤的核对问题；后补截图不是重新执行动作的结果，观察回复不直接登记动作或完成任务。"
    },
    "task_result_review": {
      "label": "复核原任务已有证据",
      "guidance": "本轮没有执行新动作；按原任务结束条件复核已有登记、历史原图与当前观察。",
      "question_from": "task_result_review"
    }
  },
