{
  "type": "object",
  "properties": {
    "foreground": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "exception": {
          "type": "string",
          "enum": [
            "none",
            "blocking_popup",
            "unexpected_exit",
            "external_app",
            "unclassified",
            "uncertain",
            "system_error"
          ]
        },
        "recovery_handoff": {
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "新对象提供来源截图中的身份裁图范围，无法可靠裁图时填null；旧对象复认可省略，需要更新身份图时再填写，不是操作范围。"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_index": {
            "type": "integer",
            "description": "唯一直接所属Region的0起始行号"
          },
          "description": {
            "type": "string",
            "description": "控件的稳定外观和作用对象描述。"
          },
          "appearance_bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "新对象提供来源截图中的身份裁图范围，无法可靠裁图时填null；旧对象复认可省略，需要更新身份图时再填写，不是操作范围。"
          },
          "click_bbox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "integer"
                  },
                  "top": {
                    "type": "integer"
                  },
                  "right": {
                    "type": "integer"
                  },
                  "bottom": {
                    "type": "integer"
                  }
                },
                "required": [
                  "left",
                  "top",
                  "right",
                  "bottom"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "实际操作目标范围；与用于辨认的appearance_bbox分别填写，可省略。"
          },
          "icon_description": {
            "type": "string",
            "description": "图标外观，用于历史辨认；没有图标时可省略。"
          }
        },
        "required": [
          "region_index"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "foreground",
    "regions",
    "controls"
  ],
  "additionalProperties": false
}
