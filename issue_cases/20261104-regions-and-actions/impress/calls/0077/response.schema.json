{
  "type": "object",
  "properties": {
    "inventory": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "uncertain"
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string",
            "enum": [
              "剪切按钮",
              "复制按钮",
              "粘贴按钮",
              "格式刷图标按钮（标准工具栏）",
              "幻灯片布局下拉按钮",
              "蓝色画板铅笔图标按钮",
              "从第一张幻灯片开始放映按钮",
              "从当前幻灯片开始放映按钮",
              "新建幻灯片按钮",
              "复制幻灯片按钮",
              "删除幻灯片按钮",
              "侧栏样式图标按钮",
              "侧栏图库图标按钮",
              "侧栏导航器图标按钮",
              "侧栏菱形图标按钮",
              "侧栏幻灯片动画图标按钮",
              "侧栏媒体图标按钮",
              "侧栏母版图标按钮",
              ""
            ]
          },
          "task_type": {
            "type": "string",
            "enum": [
              "function",
              "parameter",
              "region_content"
            ]
          },
          "completion_condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "结合本对象、已有知识与后续操作或导航需要，自行写明具体未知弄清到什么程度即可结算；允许观察推翻用途推测，不把出现预期界面或业务成功预填为必须结果，不预编操作步骤。"
          },
          "function_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "提出区块内容探索的具体理由，例如下缘条目被截断；不另建evidence字段。"
          }
        },
        "required": [
          "control",
          "task_type",
          "completion_condition"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "task_type": {
                  "const": "region_content"
                }
              },
              "required": [
                "task_type"
              ]
            },
            "then": {
              "properties": {
                "control": {
                  "const": ""
                }
              },
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    },
    "task_update": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "LibreOffice Impress 窗口/区块内容探索"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "continue",
              "answered",
              "defer"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "按需补充判断理由；不重复动作结果或已有知识。"
          },
          "remaining_question": {
            "type": "string",
            "minLength": 1,
            "description": "decision为continue或defer时必填：原问题尚未回答的具体部分；answered时不填写。"
          },
          "retry_when": {
            "type": "string",
            "minLength": 1,
            "description": "decision为defer时必填：何种条件满足后可重新推进；其他decision不填写。"
          },
          "next_action": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "control": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "click",
                      "double_click",
                      "long_press",
                      "input_text",
                      "scroll",
                      "key_press",
                      "hotkey",
                      "hover",
                      "right_click",
                      "drag",
                      "back",
                      "wait"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "region",
                  "control",
                  "action",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "task",
          "decision"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "enum": [
                    "continue",
                    "defer"
                  ]
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "required": [
                "remaining_question"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "defer"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "required": [
                "retry_when"
              ]
            }
          }
        ]
      }
    },
    "shared_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "剪切按钮",
              "复制按钮",
              "粘贴按钮",
              "格式刷图标按钮（标准工具栏）",
              "幻灯片布局下拉按钮",
              "蓝色画板铅笔图标按钮",
              "从第一张幻灯片开始放映按钮",
              "从当前幻灯片开始放映按钮",
              "新建幻灯片按钮",
              "复制幻灯片按钮",
              "删除幻灯片按钮",
              "侧栏样式图标按钮",
              "侧栏图库图标按钮",
              "侧栏导航器图标按钮",
              "侧栏菱形图标按钮",
              "侧栏幻灯片动画图标按钮",
              "侧栏媒体图标按钮",
              "侧栏母版图标按钮"
            ],
            "description": "当前区块中的控件ID。"
          },
          "source_region": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "LibreOffice Impress 窗口"
            ],
            "description": "来源区块ID。"
          },
          "source_control": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "剪切按钮",
              "复制按钮",
              "粘贴按钮",
              "格式刷图标按钮（标准工具栏）",
              "幻灯片布局下拉按钮",
              "蓝色画板铅笔图标按钮",
              "从第一张幻灯片开始放映按钮",
              "从当前幻灯片开始放映按钮",
              "新建幻灯片按钮",
              "复制幻灯片按钮",
              "删除幻灯片按钮",
              "侧栏样式图标按钮",
              "侧栏图库图标按钮",
              "侧栏导航器图标按钮",
              "侧栏菱形图标按钮",
              "侧栏幻灯片动画图标按钮",
              "侧栏媒体图标按钮",
              "侧栏母版图标按钮"
            ],
            "description": "来源控件ID。"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "control",
          "source_region",
          "source_control",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "function_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "LibreOffice Impress 窗口"
            ]
          },
          "add": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "supports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "name",
                "description",
                "supports"
              ],
              "additionalProperties": false
            }
          },
          "update": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "changes": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "supports": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "constraints": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "ref",
                "changes"
              ],
              "additionalProperties": false
            }
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "replace_with": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ref",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "region"
        ],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "enum": [
              "剪切按钮",
              "复制按钮",
              "粘贴按钮",
              "格式刷图标按钮（标准工具栏）",
              "幻灯片布局下拉按钮",
              "蓝色画板铅笔图标按钮",
              "从第一张幻灯片开始放映按钮",
              "从当前幻灯片开始放映按钮",
              "新建幻灯片按钮",
              "复制幻灯片按钮",
              "删除幻灯片按钮",
              "侧栏样式图标按钮",
              "侧栏图库图标按钮",
              "侧栏导航器图标按钮",
              "侧栏菱形图标按钮",
              "侧栏幻灯片动画图标按钮",
              "侧栏媒体图标按钮",
              "侧栏母版图标按钮"
            ],
            "description": "控件树中的控件ID，例如View 菜单。"
          },
          "knowledge": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "修订给定已有知识时引用其序号；新增省略。"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "控件用途与规则；必要的页面、模式和限制写在同一描述中。"
                },
                "constraints": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "description": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "description"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ref",
          "knowledge"
        ],
        "additionalProperties": false
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "enum": [
              "LibreOffice Impress 窗口"
            ]
          },
          "local_knowledge": {
            "type": "object",
            "properties": {
              "add": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "update": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "delete": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "ref",
          "local_knowledge"
        ],
        "additionalProperties": false
      }
    },
    "exception": {
      "type": "string",
      "enum": [
        "none",
        "blocking_popup",
        "system_error",
        "unexpected_exit",
        "external_app",
        "unclassified"
      ]
    },
    "recovery_handoff": {
      "type": "string"
    }
  },
  "required": [
    "exception",
    "recovery_handoff"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "exception": {
            "const": "none"
          }
        },
        "required": [
          "exception"
        ]
      },
      "then": {
        "required": [
          "inventory",
          "evidence",
          "operations",
          "shared_instances",
          "function_updates"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "inventory"
              ]
            },
            {
              "required": [
                "evidence"
              ]
            },
            {
              "required": [
                "operations"
              ]
            },
            {
              "required": [
                "task_update"
              ]
            },
            {
              "required": [
                "shared_instances"
              ]
            },
            {
              "required": [
                "function_updates"
              ]
            },
            {
              "required": [
                "controls"
              ]
            },
            {
              "required": [
                "regions"
              ]
            }
          ]
        }
      }
    }
  ]
}
